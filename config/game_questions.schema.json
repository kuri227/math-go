{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kuri227/math-go/config/game_questions.schema.json",
  "title": "数学でGO 問題データ",
  "type": "object",
  "additionalProperties": false,
  "required": ["questions"],
  "properties": {
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "question_latex",
        "instruction",
        "answer",
        "description",
        "difficulty",
        "category"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "question": { "type": "string", "minLength": 1 },
        "question_latex": { "type": "string", "minLength": 1 },
        "instruction": { "type": "string", "minLength": 1 },
        "answer": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "description": { "type": "string", "minLength": 1 },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 7 },
        "category": { "type": "string", "minLength": 1 }
      }
    }
  }
}
